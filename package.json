{
  "name": "AmrutamSuperApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "verify": "npm run typecheck && npm run lint",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output /tmp/amrutam.ios.jsbundle --assets-dest /tmp/amrutam-assets"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@reduxjs/toolkit": "^2.12.0",
    "@shopify/flash-list": "^2.3.2",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.3",
    "react-native": "0.87.1",
    "react-native-mmkv": "^3.3.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^8.19.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "2.8.8",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
